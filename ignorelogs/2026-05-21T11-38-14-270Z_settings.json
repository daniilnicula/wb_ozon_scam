  "generatedCode": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Настройки</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            max-width: 800px;\n            margin: 20px auto;\n            padding: 20px;\n        }\n        .section {\n            border: 1px solid #ccc;\n            padding: 15px;\n            margin-bottom: 15px;\n            border-radius: 5px;\n        }\n        .section-title {\n            font-weight: bold;\n            margin-bottom: 10px;\n            color: #333;\n        }\n        form {\n            display: flex;\n            flex-direction: column;\n            gap: 10px;\n        }\n        label {\n            display: flex;\n            align-items: center;\n            gap: 8px;\n        }\n        input[type=\"text\"],\n        input[type=\"number\"] {\n            padding: 8px;\n            border: 1px solid #ccc;\n            border-radius: 4px;\n        }\n        button {\n            padding: 10px 20px;\n            background-color: #007bff;\n            color: white;\n            border: none;\n            border-radius: 4px;\n            cursor: pointer;\n        }\n        button:hover {\n            background-color: #0056b3;\n        }\n        button.secondary {\n            background-color: #6c757d;\n        }\n        button.danger {\n            background-color: #dc3545;\n        }\n        .profiles-list {\n            list-style: none;\n            padding: 0;\n        }\n        .profiles-list li {\n            margin: 5px 0;\n            padding: 5px;\n            background-color: #f8f9fa;\n            border-radius: 4px;\n        }\n        .error-log {\n            background-color: #f8d7da;\n            color: #721c24;\n            padding: 10px;\n            border-radius: 4px;\n            margin-top: 15px;\n        }\n    </style>\n</head>\n<body>\n    <h1>Настройки</h1>\n\n    <!-- Внутренние настройки системы -->\n    <div class=\"section\">\n        <div class=\"section-title\">Внутренние настройки системы</div>\n        \n        <!-- Разрыв между секциями (вертикальная линия) -->\n        <hr style=\"border: none; border-top: 2px solid #ccc; margin: 15px 0;\">\n\n        <form action=\"{{ url_for('settings') }}\" method=\"post\">\n            <label>\n                <input type=\"checkbox\" name=\"headless\" {% if cfg.headless %}checked{% endif %}>\n                Запуск браузера в безоконном режиме\n            </label>\n\n            <label>\n                <input type=\"checkbox\" name=\"disable_media\" {% if cfg.disable_media %}checked{% endif %}>\n                Отключить загрузку медиа (фото/видео)\n            </label>\n\n            <label>\n                <input type=\"checkbox\" name=\"keep_browser_open\" {% if cfg.keep_browser_open %}checked{% endif %}>\n                Сохранять браузер открытым после обновления цен\n            </label>\n\n            <label>\n                Параллельные воркеры:\n                <input type=\"number\" name=\"concurrency\" value=\"{{ cfg.concurrency }}\" min=\"1\" max=\"20\">\n            </label>\n\n            <button type=\"submit\">Сохранить</button>\n        </form>\n    </div>\n\n    <!-- Используется готовый selenium-профиль для авторизации. Перед обновлением цен закрой браузер с этим профилем. -->\n    <div class=\"section\">\n        <div class=\"section-title\">Используется готовый selenium-профиль для авторизации</div>\n        \n        <!-- Разрыв между секциями (вертикальная линия) -->\n        <hr style=\"border: none; border-top: 2px solid #ccc; margin: 15px 0;\">\n\n        <p style=\"color: #666;\">Перед обновлением цен закрой браузер с этим профилем.</p>\n\n        <h3>Доступные Chrome-профили:</h3>\n        <ul class=\"profiles-list\">\n            {% for profile in profiles %}\n                <li>{{ profile.name }} (ID: {{ profile.id }})</li>\n            {% endfor %}\n        </ul>\n\n        <form action=\"{{ url_for('add_profile') }}\" method=\"post\">\n            <label>\n                Новый профиль:\n                <input type=\"text\" name=\"profile_name\" placeholder=\"Введите имя профиля\">\n            </label>\n            <button type=\"submit\">Добавить профиль</button>\n        </form>\n\n        <h3>Управление профилями:</h3>\n        {% for profile in profiles %}\n            <form action=\"{{ url_for('delete_profile', profile_id=profile.id) }}\" method=\"post\" style=\"display: inline;\">\n                <input type=\"hidden\" name=\"_method\" value=\"POST\">\n                <button type=\"submit\" class=\"danger\" onclick=\"return confirm('Удалить профиль {{ profile.name }}?')\">\n                    Удалить\n                </button>\n            </form>\n        {% endfor %}\n\n        <h3>Тестирование подключения:</h3>\n        <form action=\"{{ url_for('test_chrome') }}\" method=\"post\">\n            <button type=\"submit\">Проверить подключение к браузеру</button>\n        </form>\n\n        {% if errors %}\n            <h3>Последние ошибки:</h3>\n            <div class=\"error-log\">\n                {% for error in errors %}\n                    <div><strong>{{ error.ts }}:</strong> {{ error.source }} - {{ error.message }}</div>\n                {% endfor %}\n            </div>\n        {% endif %}\n\n        <a href=\"{{ url_for('clear_errors') }}\" style=\"display: inline-block; margin-top: 10px;\">Очистить логи ошибок</a>\n    </div>\n</body>\n</html>",
